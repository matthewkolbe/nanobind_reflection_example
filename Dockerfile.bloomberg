FROM ubuntu:24.04 AS clang-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    cmake \
    ninja-build \
    python3 \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone Bloomberg's clang-p2996 fork (p2996 branch)
RUN git clone --depth=1 --branch=p2996 \
    https://github.com/bloomberg/clang-p2996.git /tmp/llvm-source

# Build clang and libc++
RUN cmake -S /tmp/llvm-source/llvm -B /tmp/llvm-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/clang-p2996 \
        -DLLVM_ENABLE_PROJECTS="clang" \
        -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" \
    && cmake --build /tmp/llvm-build -j$(nproc) \
    && cmake --install /tmp/llvm-build

# --- Runtime stage ---

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    python3-dev \
    python3-pip \
    cmake \
    ninja-build \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=clang-builder /opt/clang-p2996 /opt/clang-p2996

ENV PATH="/opt/clang-p2996/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/clang-p2996/lib/x86_64-unknown-linux-gnu:/opt/clang-p2996/lib:${LD_LIBRARY_PATH}"
ENV CC=/opt/clang-p2996/bin/clang
ENV CXX=/opt/clang-p2996/bin/clang++
ENV CXXFLAGS="-stdlib=libc++"
ENV LDFLAGS="-stdlib=libc++"

RUN pip3 install --break-system-packages pytest

WORKDIR /workspace
